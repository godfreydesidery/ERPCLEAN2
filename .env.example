# Copy to .env (gitignored) and adjust. Dev defaults match docker-compose.
# Production values come from a secret store, NOT this file.

# Database
ERP_DB_URL=jdbc:postgresql://localhost:5434/erp
ERP_DB_USER=erp
ERP_DB_PASSWORD=erp

# API
ERP_API_PORT=8081

# Bootstrap (wired in Slice 2 — fresh-DB org/company/branch/root-admin)
# ERP_BOOTSTRAP_ENABLED=true
# ERP_BOOTSTRAP_ADMIN_USERNAME=rootadmin
# ERP_BOOTSTRAP_ADMIN_PASSWORD=         # >= 12 chars, no placeholders, or the app refuses to start
