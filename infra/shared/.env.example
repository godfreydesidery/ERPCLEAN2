# Shared multi-tenant server environment template (infra/shared). Copy to infra/shared/.env
# (gitignored) and replace EVERY placeholder. Never commit infra/shared/.env or jwt-keys/.
# Generate secrets with: openssl rand -base64 24

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- Public host / TLS (Caddy) -------------------------------------------------
ERP_PUBLIC_HOST=
# 'internal' = self-signed. For Let's Encrypt set a real domain above and the ACME email here.
ERP_CADDY_TLS=internal

# ---- First boot: creates the platform operator 'rootadmin' ---------------------
# true ONLY for the first boot of an empty database; then false. Name the organisation after the
# VENDOR (e.g. "Orbix Platform"), not a customer: it is the operator's own, and customers are
# created later with POST /api/v1/organisations.
ERP_BOOTSTRAP_ENABLED=false
ERP_BOOTSTRAP_ORG_NAME=CHANGE_ME Platform
ERP_BOOTSTRAP_COMPANY_CODE=PLAT
ERP_BOOTSTRAP_COMPANY_NAME=CHANGE_ME Platform
ERP_BOOTSTRAP_BRANCH_CODE=BR-01
ERP_BOOTSTRAP_BRANCH_NAME=Head Office
ERP_BOOTSTRAP_TIME_ZONE=Africa/Dar_es_Salaam
# >= 12 chars, letters + a digit, not a placeholder - or the app refuses to start.
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- JWT RS256 (paths INSIDE the container) ------------------------------------
ERP_JWT_PRIVATE_KEY=/run/secrets/jwt/private.pem
ERP_JWT_PUBLIC_KEY=/run/secrets/jwt/public.pem
# Host directory holding private.pem + public.pem (default ./jwt-keys beside the compose file).
# ERP_JWT_KEY_DIR=./jwt-keys

# ---- Capacity (defaults suit roughly 5-20 small tenants; arithmetic in docs/ops/shared-instance.md)
# Postgres max_connections and the API's Hikari pool. Keep:
#   ERP_DB_POOL_MAX + 3 (superuser reserve) + 10 (operators, backups) <= PG_MAX_CONNECTIONS
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
ERP_DB_POOL_MAX=20
ERP_DB_POOL_MIN_IDLE=5
ERP_SCHEDULER_POOL_SIZE=4
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

# ---- Point-in-time recovery (docs/ops/shared-instance-pitr.md) ------------------
# Max seconds before a part-filled WAL segment is archived = worst-case data loss on a quiet server.
PG_ARCHIVE_TIMEOUT=300
# Complete base backups to keep (prune.sh also removes WAL older than the oldest kept backup).
BASEBACKUP_KEEP=7

# ---- Do not set -------------------------------------------------------------
# ERP_FISCAL_PROVIDER is pinned to 'none' in the compose file: this server does not fiscalise.
# Replica count is pinned to 1: the scheduler is not multi-node safe.
# ERP_SHARED_VOLUME_PREFIX / COMPOSE_PROJECT_NAME are for throwaway drills only.
