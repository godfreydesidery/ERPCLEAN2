# ERPCLEAN2 production environment template.
# Copy this file to infra/prod/.env (gitignored) and replace EVERY placeholder
# before starting the stack.  infra/prod/.env is NEVER committed.
#
# Rules:
#   - Passwords must be >= 16 chars, randomly generated (use `openssl rand -base64 24`).
#   - ERP_BOOTSTRAP_ADMIN_PASSWORD must be >= 12 chars.  On a fresh DB the app will
#     refuse to start if this is still the placeholder value.
#   - ERP_JWT_PRIVATE_KEY / ERP_JWT_PUBLIC_KEY are the paths INSIDE the container
#     (the jwt-keys bind mount lands at /run/secrets/jwt/).
#   - After first successful bootstrap you may set ERP_BOOTSTRAP_ENABLED=false and
#     restart to suppress the bootstrap log message.

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- Spring Boot datasource (resolved at runtime; mirrors Postgres creds above) --
# These are set automatically from POSTGRES_* in docker-compose.yml; you only need
# to override them if you are using an external managed Postgres instance.
# ERP_DB_URL=jdbc:postgresql://db:5432/erp
# ERP_DB_USER=erp
# ERP_DB_PASSWORD=CHANGE_ME_strong_db_password

# ---- API host port (host-side mapping; container always uses 8081) ---------------
ERP_API_HOST_PORT=8081

# ---- Public host for TLS (Caddy reverse proxy) ---------------------------------
# The hostname or IP this box is reached at: the EC2 public DNS, an Elastic IP, or your
# domain. Caddy binds its :80/:443 site to this and issues a cert for it. REQUIRED for HTTPS
# (a bare :443 has no name to issue a self-signed cert for -> ERR_SSL_PROTOCOL_ERROR).
# With a real domain here AND `tls internal` removed from the Caddyfile, Caddy auto-issues
# a trusted Let's Encrypt cert instead.
ERP_PUBLIC_HOST=

# ---- First-run bootstrap -------------------------------------------------------
# Set to true ONLY on first deploy of a fresh database.  After bootstrap completes
# set to false and redeploy to suppress the startup warning.
ERP_BOOTSTRAP_ENABLED=false
ERP_BOOTSTRAP_ORG_NAME=My Organisation
ERP_BOOTSTRAP_COMPANY_CODE=C1
ERP_BOOTSTRAP_COMPANY_NAME=My Company
ERP_BOOTSTRAP_BRANCH_CODE=BR-01
ERP_BOOTSTRAP_BRANCH_NAME=Head Office
ERP_BOOTSTRAP_TIME_ZONE=Africa/Dar_es_Salaam
# Minimum 12 chars; must not be the placeholder string or the app refuses to start.
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- JWT RS256 key paths (inside the container; mounted at /run/secrets/jwt/) ---
ERP_JWT_PRIVATE_KEY=/run/secrets/jwt/private.pem
ERP_JWT_PUBLIC_KEY=/run/secrets/jwt/public.pem

# ---- JVM tuning (optional override) --------------------------------------------
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
