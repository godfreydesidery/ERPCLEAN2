# Env-driven first-run bootstrap for the ERPCLEAN2 QA container.
# Copy to `qa.env` ON THE BOX (gitignored), fill in the secrets, then deploy.
# deploy.ps1 / deploy.sh pass this file to `docker run --env-file`.
#
# On a fresh DB the app self-bootstraps org + company + branch + the company-wide
# `rootadmin`. On an already-bootstrapped DB it's a no-op.

ERP_BOOTSTRAP_ENABLED=true

# Organisation / company / branch
ERP_BOOTSTRAP_ORG_NAME=ERP QA
ERP_BOOTSTRAP_COMPANY_CODE=C1
ERP_BOOTSTRAP_COMPANY_NAME=ERP QA Company
ERP_BOOTSTRAP_BRANCH_CODE=BR-01
ERP_BOOTSTRAP_BRANCH_NAME=Head Office
ERP_BOOTSTRAP_TIME_ZONE=Africa/Dar_es_Salaam

# rootadmin password — read at bootstrap. Must be >= 12 chars and not a common
# placeholder, or the app refuses to start. Username "rootadmin" is fixed in code.
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_to_a_strong_secret

# In-container Postgres credentials (the entrypoint creates this role + db).
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=CHANGE_ME_to_a_db_password
