# QA deploy target — non-secret config, read by deploy.ps1 / deploy.sh.
# The SSH key path and any GitHub PAT are NOT here — pass those via env
# ($env:ERP_SSH_KEY / $env:GH_PAT) or the gitignored deploy.env.local.

EC2_HOST=16.170.11.41
EC2_USER=ubuntu
BRANCH=main
REMOTE_DIR=erpclean2
CONTAINER=erpclean2
IMAGE=erpclean2:qa
DB_VOLUME=erpclean2-data
# Repo cloned on the box (the bootstrap step clones this). The deploy git-pulls it.
REPO=github.com/godfreydesidery/ERPCLEAN2.git
