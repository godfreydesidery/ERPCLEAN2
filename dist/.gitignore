# Release build output — regenerated by build-release.sh / .ps1, never committed.
# app.jar is ~100 MB and the image tarballs are hundreds of megabytes each.
build/
release/

# Image tarballs are produced into the assembled bundle, never into the templates.
bundle/images/*.tar
bundle/images/*.tar.gz

# LAN / Windows-service package - contains the built jar and the WinSW binary.
lan/

# Android release signing key for OrbixPOS (keystore + passwords). NEVER committed; back it up -
# every future update of the Android app must be signed with this same key.
android-signing/

# Android app builds (OrbixPOS APK) - delivered by the owner, never committed.
*.apk
