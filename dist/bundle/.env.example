#############################################################################
#  OrbixERP — configuration
#
#  This is the ONLY file you need to edit. The installer copies it to `.env`
#  and fills in the passwords for you; edit `.env` (not this file) afterwards
#  and run `./orbixerp.sh restart` for changes to take effect.
#
#  `.env` contains passwords. Keep it as safe as you keep the database itself,
#  and include it in your off-machine backups together with the `secrets/`
#  folder — without those two, a restored database cannot be logged into.
#############################################################################


#############################################################################
#  1. DATABASE MODE  — the one setting that changes how everything is wired
#############################################################################

# docker  = we run PostgreSQL for you in a container. Nothing to install.
#           Your data lives in the Docker volume `orbixerp-db-data` on this machine.
#           Choose this unless you have a specific reason not to.
#
# host    = you point the application at a PostgreSQL server you already run.
#           You manage that server's storage, backups and availability.
#           READ docs/HOST-DB-SETUP.md FIRST — the database must exist and be
#           empty before the application starts.
#
# You can switch later: back up, change this value, restore into the new
# database, then `./orbixerp.sh restart`. See docs/OPERATIONS.md.
ERP_DB_MODE=docker


#############################################################################
#  2. DATABASE CONNECTION
#############################################################################

# --- Used in BOTH modes -----------------------------------------------------
ERP_DB_NAME=erp
ERP_DB_USER=erp
# Generated by the installer. In `docker` mode this is the password the
# container is created with — changing it later does NOT change the existing
# database password. In `host` mode it must match the password of the login
# role on your own server.
ERP_DB_PASSWORD=

# --- Used in `host` mode ONLY (ignored in `docker` mode) ---------------------
# The special name below means "the machine this software is running on". Use it
# if PostgreSQL is installed directly on this same computer. If your database is
# on another server, replace it with that server's hostname or IP address.
ERP_DB_HOST=host.docker.internal
ERP_DB_PORT=5432
# Extra JDBC connection settings, appended to the URL. Leave empty unless your
# database requires encrypted connections, in which case use:  ?sslmode=require
ERP_DB_URL_PARAMS=


#############################################################################
#  3. HOW USERS REACH THE SYSTEM
#############################################################################

# The port users browse to:  http://<this-machine>:8080
# Change this if 8080 is already in use on this machine.
# (80 is a common alternative but is often taken on Windows.)
ERP_HTTP_PORT=8080

# 0.0.0.0   = reachable from other computers and devices on your network.
#             Required for multi-user use and for the POS application.
# 127.0.0.1 = reachable ONLY from this machine. Also set this when you turn on
#             HTTPS below, so the unencrypted port is not exposed.
ERP_BIND_ADDR=0.0.0.0

# --- Optional HTTPS ---------------------------------------------------------
# Leave false for normal use on a trusted local network.
# Setting true requires ERP_PUBLIC_HOST below. Read docs/OPERATIONS.md first:
# without a real domain name your browser will warn that the certificate is not
# trusted, which is expected.
ERP_TLS_ENABLED=false
# The name or IP address users type in the browser, e.g. erp.mycompany.co.tz
ERP_PUBLIC_HOST=
ERP_HTTPS_PORT=443
ERP_HTTP_REDIRECT_PORT=80


#############################################################################
#  4. FIRST-RUN SETUP
#
#  These are read ONCE, when the application starts against an empty database,
#  to create your organisation and the first administrator account. After that
#  they are ignored — changing them later does NOT rename anything. Use the
#  application's own screens for that.
#############################################################################

# The installer sets this to true for a first install and false afterwards.
ERP_BOOTSTRAP_ENABLED=true

ERP_BOOTSTRAP_ORG_NAME=My Organisation
ERP_BOOTSTRAP_COMPANY_CODE=C1
ERP_BOOTSTRAP_COMPANY_NAME=My Company
ERP_BOOTSTRAP_BRANCH_CODE=BR-01
ERP_BOOTSTRAP_BRANCH_NAME=Head Office

# The first administrator. The username is always `rootadmin`.
# The password must be at least 12 characters — the application refuses to
# start otherwise. The installer generates a strong one and prints it once.
# CHANGE IT after your first login, from within the application.
ERP_BOOTSTRAP_ADMIN_PASSWORD=

# Currency the accounts are kept in, and the currencies available for use.
# These cannot be changed casually after go-live — set them correctly now.
ERP_BOOTSTRAP_CURRENCY_BASE=TZS
ERP_BOOTSTRAP_CURRENCY_DEFAULT=TZS
ERP_BOOTSTRAP_CURRENCY_ENABLED=TZS,KES,UGX,RWF,BIF,SSP,USD,EUR


#############################################################################
#  5. REGIONAL
#############################################################################

# Timezone used for dates and times shown in the application and written to the
# logs. Use a full name from the IANA list, e.g. Africa/Dar_es_Salaam,
# Africa/Nairobi, Europe/London.
ERP_TIME_ZONE=Africa/Dar_es_Salaam
# Timezone recorded on your organisation at first-run setup. Keep it the same
# as ERP_TIME_ZONE.
ERP_BOOTSTRAP_TIME_ZONE=Africa/Dar_es_Salaam


#############################################################################
#  6. ADVANCED — you can usually ignore everything below
#############################################################################

# Which build is installed. The installer sets this; do not edit it by hand.
# `./orbixerp.sh update` changes it as part of a controlled upgrade.
ERP_VERSION=__ERP_VERSION__
ERP_IMAGE=orbixerp-api

# Names this installation's containers, network and data volume. Leave it as "orbixerp".
#
# Change it ONLY if you want a SECOND, separate instance on the same machine - a training
# or demonstration system alongside the real one. In that case: unzip the bundle into a
# different folder, set a different name (e.g. orbixerp-training) AND a different ERP_HTTP_PORT
# there, then install. The two keep entirely separate databases.
#
# Never change this on a running installation: the system would look for a fresh, empty
# database under the new name and appear to have lost all your data.
ERP_STACK_NAME=orbixerp

# The interactive API documentation page. Off on a client install because it
# describes every endpoint in the system to anyone who can reach the server.
ERP_SWAGGER_ENABLED=false

# Java memory. The default lets the application use up to 75% of whatever memory
# Docker gives the container. Raise MaxRAMPercentage only if you have also given
# Docker more memory. 4 GB of RAM for this machine is a sensible minimum.
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

# Database connection pool size. Set this if your database server enforces a low
# connection limit and you see "connection refused" under load.
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# How many threads run the scheduled background jobs. Spring Boot's default is ONE,
# shared by every scheduled job in the system - the outbox dispatcher, the nightly
# standing-order run, the notification scan and the metrics sweep. On the default a
# single slow job delays all the others: the hourly notification scan walks every
# company in turn, and while it runs the midnight standing-order run cannot start.
SPRING_TASK_SCHEDULING_POOL_SIZE=4

# How many days of backups `./orbixerp.sh backup` keeps in the backups/ folder.
ERP_BACKUP_RETAIN_DAYS=14
