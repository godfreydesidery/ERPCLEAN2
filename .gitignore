# Secrets — never commit (PROJECT-CONVENTIONS §3.7 / security policy)
.env
*.key
*.pem
*.pfx
*.p12
**/orbix.env
**/*.local.md
# QA deploy secrets (kept locally + on the box, never committed). The committed
# templates qa.env.example / deploy.env are safe; qa.env / deploy.env.local are not.
**/qa.env
**/deploy.env.local
# Prod secrets — .env and jwt-keys/ are never committed (only .env.example is).
infra/prod/.env
infra/prod/jwt-keys/

# Backend (Maven / Java)
backend/target/
*.class
hs_err_pid*.log

# Web (Angular / Node)
web/node_modules/
web/dist/
web/.angular/
npm-debug.log*

# Playwright run artifacts — regenerated on every run, never commit.
# (e2e SPECS live in web/e2e/ and ARE tracked; these are run OUTPUT only.)
web/test-results/
web/playwright-report/
web/pw-*.json
web/pw-*.txt

# Local infra data
infra/local-data/

# IDE / OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Logs
*.log

# SPA bundle injected at Docker build time — never commit
backend/src/main/resources/static/

# Agent worktrees (local scratch — never commit)
.claude/worktrees/

# Workflow agent worktrees (alt path) — never commit
.claire/

# Microsoft Office lock/temp files (e.g. ~$USER-MANUAL.docx — created while a doc is open)
~$*
